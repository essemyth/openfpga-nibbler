# ROM data is copyrighted: never commit it.
*.rom
*.zip
pkg/Assets/**/*
!pkg/Assets/**/.gitkeep

# Build outputs from tools/
build/
sim/obj_dir/
sim/*.vcd
sim/*.fst

# Quartus build products (regenerated by tools/build.ps1)
src/fpga/output_files/*
!src/fpga/output_files/.gitignore
src/fpga/apf/build_id.mif
src/fpga/*.qdf
pkg/Cores/*/bitstream.rbf_r

# Simulation outputs
sim/out/

# Test data made from the game (see sim/make_test_hi.ps1)
sim/data/

# Release packages (tools/package.ps1)
release/
